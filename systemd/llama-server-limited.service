[Unit]
Description=llama-server (profile: limited) - reduced VRAM footprint, for sharing the GPU with a desktop session
Documentation=file:%h/llama-server/README.md
Conflicts=llama-server-full-128k.service llama-server-full-256k.service
# Give up instead of restarting forever on a *persistent* failure. systemd's
# defaults here (verified on this box with `systemctl --user show -p
# DefaultStartLimitIntervalUSec -p DefaultStartLimitBurst`: 10s / 5) can
# never be tripped by this unit, because RestartSec is longer than
# interval/burst - at one restart per 5s only 2 starts land in a 10s window,
# the counter resets, and a unit that fails every single time restarts
# indefinitely. The realistic persistent failure on this box is the cgroup
# OOM kill that MemoryMax below is *designed* to cause, and each iteration
# re-reads 22GB from disk under --no-mmap, so the safety net would otherwise
# become the trigger for an unbounded reload loop. At RestartSec=30 a
# genuinely broken config burns its 5 tries in ~2 minutes, then enters
# `failed` and stays there for a human (`systemctl --user reset-failed
# <unit>` to clear).
#
# 5/300 rather than a tighter 3/600 because *manual* restarts count toward
# this limit too, and this repo's workflow is "edit the tunables file,
# restart, observe". 3-per-10-minutes was tried first and blocked a
# legitimate tuning session on the fourth restart - tight enough to stop a
# crash loop is not the same as tight enough to fight the operator.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/llama-server
# Tunables live outside the repo (installed by ../install.sh) so they
# survive `git pull` / reclones; llm-server.sh treats a missing file as
# "use built-in defaults" rather than an error, so this works even before
# install.sh has been run.
ExecStart=%h/llama-server/scripts/llm-server.sh --tunables-file %h/.config/llama-server/limited.env
Restart=on-failure
# 30s, not 5s: a restart here re-reads 22GB from disk under --no-mmap, so
# retrying in 5s only piles a second cold load onto a box that may still be
# recovering from whatever killed the first one. Costs nothing on a genuine
# transient, and keeps RestartSec well inside the StartLimit window above.
RestartSec=30
# No TimeoutStartSec here on purpose. It used to be 300, described as
# covering the 22GB model load - it never did: under Type=simple systemd
# marks the unit active the moment the fork succeeds, so nothing is timed
# during load (Type=exec wouldn't help either, it only waits for exec()).
# With it gone the unit inherits DefaultTimeoutStartUSec, 15s on this box,
# which is equally inert for the same reason. If Type= ever becomes notify
# or an ExecStartPre/ExecStartPost is added, that 15s default *will* apply
# and must be raised past the real load time before anything else changes.
# Making start completion mean "model loaded" needs an ExecStartPost that
# polls /health, not a timeout.
# Safety net for a desktop box also used for browsing: cap this cgroup so a
# runaway (a genuine leak, a bad tunable, anything else) gets killed
# and restarted by systemd instead of taking down the whole session via the
# system-wide OOM killer. This profile runs cache-ram=5120, raised from 3072
# after measuring a near-full context: at 131072 ctx a single ~125k-token
# branch needs ~4 GiB of prompt cache, so 3072 could not hold even ONE and
# every branch switch reprocessed the whole prompt (125702 tokens, 190s).
# At 5120 the same switch cost 5 tokens and 0.32s. --cache-ram is a CAP, not
# a reservation, so the limiting factor is MemoryMax below, not this number.
# See limited.env's comments and README's "Memory stability" section.
#
# This profile is the one that shares RAM with a live desktop session, and
# despite the name it is the *most* host-RAM-hungry of the three: it runs on
# graphical.target where the GPU is busy, so ncmoe=33 keeps more MoE layers
# on the CPU than full-128k (27) or full-256k (32). full-*'s higher ceilings
# are fine because they only run under multi-user.target with nothing else
# competing; this one has to leave a desktop alive.
#
# Sized from measurement against a NEAR-FULL CONTEXT (2026-07-25). The number
# that matters is anon+shmem - memory that cannot be reclaimed cheaply:
#     resting                     15.74 shmem + 0.50 anon = 16.24 GiB
#     125,701-token ctx + 2nd branch                      = 21.16 GiB
#
# An earlier pass sized these at 21G/23G from a 3-branches-x-34k-token test
# that peaked at only 18.8 GiB. That workload was not representative, and the
# undersizing wedged the server: an overnight job reached an 88,591-token
# context, crossed MemoryHigh with zero page cache left to reclaim and (then)
# MemorySwapMax=0, and the kernel spun in direct reclaim for 8 hours - state
# D, no HTTP responses, no OOM kill, no restart. Size this against a full
# 131072 context, not a synthetic multi-branch test.
#
# 23G/25G clears the 21.16 GiB worst case with ~2GiB of headroom above
# MemoryHigh and ~4GiB below the hard cap, leaving ~6GiB of the 31Gi box for
# the desktop. Do not go back below ~23G: the previous 25G/27G left only
# ~4GB and caused desktop-wide allocation failures (sound card disappearing,
# password manager unable to open its DB), while 21G/23G caused the deadlock
# above. The safe band is narrow.
#
# Do not judge these by memory.current alone: much of it is page cache from
# reading a 22GB GGUF under --no-mmap, which reclaims for free and makes the
# memory.events "high" counter look alarming when nothing is wrong. Check
# anon+shmem, memory.swap.current and oom_kill instead. See README's "Memory
# stability" section.
MemoryHigh=23G
MemoryMax=25G
# Bounded, deliberately NOT 0 and NOT unlimited - both extremes fail here.
#
# Unlimited (the cgroup default, memory.swap.max=max) defeats MemoryMax:
# swap on this box is zram (/dev/zram0, compressed RAM - not disk), so under
# pressure the kernel relocates anon/shmem into zram, dropping it out of
# memory.current. MemoryMax never trips, nothing restarts, and the pages
# still occupy physical RAM - just charged outside this cgroup. The cap
# escapes itself and the shortfall lands on the desktop.
#
# 0 was tried next and is worse: with no swap outlet AND no reclaimable page
# cache left, a cgroup that reaches MemoryHigh can neither free memory nor be
# cleanly OOM-killed, so the kernel spins in direct reclaim indefinitely. That
# is what wedged the server for 8 hours on 2026-07-25 (process in state D,
# 27M memory.events "high", zero HTTP responses, oom_kill still 0). A silent
# deadlock is worse than either finishing slowly or dying and restarting.
#
# 4G gives the kernel an escape valve while keeping MemoryMax meaningful -
# total charge stays bounded at MemoryMax + 4G. In validation the valve was
# barely used (0.00-0.37 GiB), which is the point: it exists to prevent
# deadlock, not to be a working surface.
MemorySwapMax=4G
# Prefer the kernel kill *this* process over other apps in a system-wide OOM,
# since it's expendable (Restart=on-failure brings it back) and your desktop
# session isn't.
OOMScoreAdjust=500

[Install]
WantedBy=default.target
