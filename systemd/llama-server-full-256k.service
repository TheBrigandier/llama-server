[Unit]
Description=llama-server (profile: full-256k) - max context, used occasionally
Documentation=file:%h/llama-server/README.md
Conflicts=llama-server-full-128k.service llama-server-limited.service
# Give up instead of restarting forever on a *persistent* failure. systemd's
# defaults here (verified on this box with `systemctl --user show -p
# DefaultStartLimitIntervalUSec -p DefaultStartLimitBurst`: 10s / 5) can
# never be tripped by this unit, because RestartSec is longer than
# interval/burst - at one restart per 5s only 2 starts land in a 10s window,
# the counter resets, and a unit that fails every single time restarts
# indefinitely. The realistic persistent failure on this box is the cgroup
# OOM kill that MemoryMax below is *designed* to cause, and each iteration
# re-reads 22GB from disk under --no-mmap, so the safety net would otherwise
# become the trigger for an unbounded reload loop. At RestartSec=30 a
# genuinely broken config burns its 5 tries in ~2 minutes, then enters
# `failed` and stays there for a human (`systemctl --user reset-failed
# <unit>` to clear).
#
# 5/300 rather than a tighter 3/600 because *manual* restarts count toward
# this limit too, and this repo's workflow is "edit the tunables file,
# restart, observe". 3-per-10-minutes was tried first and blocked a
# legitimate tuning session on the fourth restart - tight enough to stop a
# crash loop is not the same as tight enough to fight the operator.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/llama-server
# Tunables live outside the repo (installed by ../install.sh) so they
# survive `git pull` / reclones; llm-server.sh treats a missing file as
# "use built-in defaults" rather than an error, so this works even before
# install.sh has been run.
ExecStart=%h/llama-server/scripts/llm-server.sh --tunables-file %h/.config/llama-server/full-256k.env
Restart=on-failure
# 30s, not 5s: a restart here re-reads 22GB from disk under --no-mmap, so
# retrying in 5s only piles a second cold load onto a box that may still be
# recovering from whatever killed the first one. Costs nothing on a genuine
# transient, and keeps RestartSec well inside the StartLimit window above.
RestartSec=30
# No TimeoutStartSec here on purpose. It used to be 300, described as
# covering the 22GB model load - it never did: under Type=simple systemd
# marks the unit active the moment the fork succeeds, so nothing is timed
# during load (Type=exec wouldn't help either, it only waits for exec()).
# With it gone the unit inherits DefaultTimeoutStartUSec, 15s on this box,
# which is equally inert for the same reason. If Type= ever becomes notify
# or an ExecStartPre/ExecStartPost is added, that 15s default *will* apply
# and must be raised past the real load time before anything else changes.
# Making start completion mean "model loaded" needs an ExecStartPost that
# polls /health, not a timeout.
# Safety net for a desktop box also used for browsing: cap this cgroup so a
# runaway (a genuine leak, a bad tunable, anything else) gets killed
# and restarted by systemd instead of taking down the whole session via the
# system-wide OOM killer. This profile's 262144 ctx means a bigger baseline
# KV footprint than full-128k/limited (not directly measured), and
# cache-ram=8192 (see README's "Memory stability" section) adds up to ~8G
# more on top in the worst case - these leave the least desktop headroom of
# the three by design, since this deployment is meant for occasional use,
# not as the daily driver.
#
# Only bumped +1G/unchanged (not the same +2G as full-128k) despite the
# same "don't penalize cache-ram=8192 with throttling" motivation: total
# system RAM is 31Gi, and MemoryMax=30G already leaves only ~1Gi as a hard
# floor. Going higher would mean the cgroup could never actually reach its
# own "limit" before the whole system hit global memory exhaustion first -
# making the safety net meaningless for this profile specifically. Watch
# `systemctl --user status llama-server-full-256k` peak memory and adjust
# down if it's tripping the ceiling, since there's little room left to
# raise it further on this box.
MemoryHigh=29G
MemoryMax=30G
# Bounded, deliberately neither unlimited nor 0. Unlimited (the cgroup
# default) defeats MemoryMax: swap here is zram (/dev/zram0, compressed RAM -
# not disk), so the kernel relocates anon/shmem into zram, dropping it out of
# memory.current - the cap never trips while the RAM is still consumed,
# charged outside this cgroup. But 0 is worse: with no swap outlet AND no
# reclaimable page cache left, a cgroup at MemoryHigh can neither free memory
# nor be cleanly OOM-killed, and the kernel spins in direct reclaim forever.
# That deadlocked `limited` for 8 hours on 2026-07-25 (state D, 27M
# memory.events "high", zero HTTP responses, oom_kill still 0). 4G leaves an
# escape valve while keeping total charge bounded at MemoryMax + 4G.
#
# The ceilings above stay high (unlike `limited`'s 23G/25G) because this
# profile only runs under multi-user.target, with no desktop session
# competing for RAM. Don't copy these numbers to a profile that runs on
# graphical.target.
#
# NOT YET VALIDATED against a near-full context: this profile cannot be
# started from a graphical session, so the near-full-131072 measurement that
# re-sized `limited` has not been repeated here. `limited`'s ceilings proved
# wrong by ~2.5GiB when sized from a synthetic test - treat these as
# provisional and re-measure under multi-user.target before trusting them.
MemorySwapMax=4G
# Prefer the kernel kill *this* process over other apps in a system-wide OOM,
# since it's expendable (Restart=on-failure brings it back) and your desktop
# session isn't.
OOMScoreAdjust=500

[Install]
WantedBy=default.target
