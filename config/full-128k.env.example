# Tunables for llama-server-full-128k.service - primary daily-driver config.
#
# Installed by install.sh to ~/.config/llama-server/full-128k.env and passed
# to llm-server.sh via --tunables-file by systemd/llama-server-full-128k.service.
# Edit values here and `systemctl --user restart llama-server-full-128k.service`
# to pick them up - no need to touch the .service file or llm-server.sh.
#
# These happen to match llm-server.sh's own built-in defaults already, since
# "full-128k" is the fastest single-GPU-only setup - but they're listed
# explicitly here so this file is a complete, self-contained record of the
# deployment, and so this stays true even if the script's defaults change.
# Anything left commented uses llm-server.sh's shared default for that
# value. Uncomment and edit any line to override it. Full explanations of
# each value: ../scripts/llm-server.sh --help

# --- values that define this deployment (uncommented for visibility) ---
LLAMA_NGL=99
LLAMA_NCMOE=27
LLAMA_THREADS=12
LLAMA_CTX_SIZE=131072

# --- memory stability (uncommented - see README's "Memory stability" section) ---
# llama-server's own defaults (cache-ram=8192, ctx-checkpoints=32) leave no
# RAM headroom on a 32GB desktop box also used for browsing, and context
# checkpoints are known-broken (never successfully restored, pure overhead)
# on this model's hybrid/recurrent architecture as of llama.cpp b10087 -
# see https://github.com/ggml-org/llama.cpp/issues/24055
LLAMA_CACHE_RAM=1024
LLAMA_CTX_CHECKPOINTS=0

# --- everything else (commented = using llm-server.sh's shared default) ---
#LLAMA_MODEL_PATH="$HOME/llama-server/models/Qwen3.6-35B-A3B-MTP-UD-Q4_K_XL.gguf"
#LLAMA_PARALLEL=1                # must stay 1 while LLAMA_SPEC_TYPE=draft-mtp
#LLAMA_CACHE_TYPE_K=q8_0
#LLAMA_CACHE_TYPE_V=q8_0
#LLAMA_SPEC_TYPE=draft-mtp
#LLAMA_SPEC_DRAFT_N_MAX=4        # tuned by testing - falls off sharply above 4
#LLAMA_TEMP=1.0
#LLAMA_TOP_P=0.95
#LLAMA_TOP_K=20
#LLAMA_PRESENCE_PENALTY=1.5
#LLAMA_HOST=0.0.0.0
#LLAMA_PORT=8080
#LLAMA_NO_MMAP=1                 # 1 = pass --no-mmap, 0 = allow mmap
#LLAMA_FLASH_ATTN=on
#LLAMA_EXTRA_ARGS=""
