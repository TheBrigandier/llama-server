# Template for the llm-server.sh secrets file.
#
# This file is an example only - it is safe to commit to git. The real
# file with real values must live OUTSIDE this repo, at:
#
#   ~/.config/llama-server/secrets.env
#
# Setup:
#   mkdir -p ~/.config/llama-server
#   chmod 700 ~/.config/llama-server
#   cp config/llama-server.env.example ~/.config/llama-server/secrets.env
#   chmod 600 ~/.config/llama-server/secrets.env
#   $EDITOR ~/.config/llama-server/secrets.env
#
# It is sourced as a plain shell script by scripts/llm-server.sh (and,
# transitively, by the systemd units), so any LLAMA_* variable documented
# in `scripts/llm-server.sh --help` can be set here - not just the API key.

LLAMA_API_KEY="change-me"

# Uncommon, but available if you want to keep other things out of the repo
# or override a value machine-wide without touching profile defaults, e.g.:
# LLAMA_MODEL_PATH="$HOME/llama-server/models/Qwen3.6-35B-A3B-MTP-UD-Q4_K_XL.gguf"
