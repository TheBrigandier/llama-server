# Tunables for llama-server-full-256k.service - max context, used occasionally.
#
# Installed by install.sh to ~/.config/llama-server/full-256k.env and passed
# to llm-server.sh via --tunables-file by systemd/llama-server-full-256k.service.
# Edit values here and `systemctl --user restart llama-server-full-256k.service`
# to pick them up - no need to touch the .service file or llm-server.sh.
#
# Anything left commented uses llm-server.sh's built-in default for that
# value. Uncomment and edit any line to override it. Full explanations of
# each value: ../scripts/llm-server.sh --help

# --- values that define this deployment (uncommented for visibility) ---
LLAMA_NGL=99
LLAMA_NCMOE=32
LLAMA_THREADS=12
LLAMA_CTX_SIZE=262144

# --- memory stability (uncommented - see README's "Memory stability" section) ---
# Context checkpoints are known-broken (never successfully restored, pure
# overhead) on this model's hybrid/recurrent architecture as of llama.cpp
# b10087 - see https://github.com/ggml-org/llama.cpp/issues/24055
#
# cache-ram is back at llama-server's own 8192 MiB default (not cut down)
# after measuring the actual working set this repo's sequential-subagent
# workflow needs: ~11 KiB/token (only ~10-11 of 41 layers are full
# attention, per the GGUF's full_attention_interval=4 - the rest are
# fixed-size recurrent state), so a max-256k-context branch costs ~2.75GiB
# and 8192 MiB covers ~3 of them resident at once (orchestrator + active
# subagent + slack). Cutting this to "save" desktop RAM previously turned
# fast orchestrator<->subagent handoffs into 90+ second full reprocesses -
# see README's Memory stability section before lowering it again. This
# deployment's 262144 ctx already has a bigger baseline KV footprint than
# full-128k/limited on top of that, so headroom is tightest here - watch
# `systemctl --user status llama-server-full-256k` peak memory after use.
LLAMA_CACHE_RAM=8192
LLAMA_CTX_CHECKPOINTS=0

# --- everything else (commented = using llm-server.sh's built-in default) ---
#LLAMA_MODEL_PATH="$HOME/llama-server/models/Qwen3.6-35B-A3B-MTP-UD-Q4_K_XL.gguf"
#LLAMA_PARALLEL=1                # must stay 1 while LLAMA_SPEC_TYPE=draft-mtp
#LLAMA_CACHE_TYPE_K=q8_0
#LLAMA_CACHE_TYPE_V=q8_0
#LLAMA_SPEC_TYPE=draft-mtp
#LLAMA_SPEC_DRAFT_N_MAX=4        # tuned by testing - falls off sharply above 4
#LLAMA_TEMP=1.0
#LLAMA_TOP_P=0.95
#LLAMA_TOP_K=20
#LLAMA_PRESENCE_PENALTY=1.5
#LLAMA_HOST=0.0.0.0
#LLAMA_PORT=8080
#LLAMA_NO_MMAP=1                 # 1 = pass --no-mmap, 0 = allow mmap
#LLAMA_FLASH_ATTN=on
#LLAMA_EXTRA_ARGS=""
