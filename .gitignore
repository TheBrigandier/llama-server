# Model weights - never commit, keep the directory itself via models/.keep
models/*
!models/.keep

# Secrets belong outside this repo (~/.config/llama-server/secrets.env,
# ~/.config/llama-server/api-keys); these guard against one accidentally
# being created/committed here.
*.env
!*.env.example
api-keys
!api-keys.example

*.log
*.pid
nohup.out
core
core.*

# editor/OS cruft
*.swp
*.swo
*~
.DS_Store
